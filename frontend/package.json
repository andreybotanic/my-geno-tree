{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-ts",
    "api:check": "node scripts/verify-api-generation.mjs",
    "build": "npm run api:check && tsc -b && vite build",
    "lint": "oxlint && eslint .",
    "quality": "npm run api:check && npm run lint && npm run typecheck",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@lume/kiwi": "0.4.4",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "i18next": "^26.3.6",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  }
}
