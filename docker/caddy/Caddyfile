http://:8080 {
	redir https://my-geno-tree.localhost{uri} 302
}

localhost, my-geno-tree.localhost {
	tls internal
	encode zstd gzip

	handle /.well-known/mercure {
		reverse_proxy mercure:80 {
			flush_interval -1
		}
	}

	handle /mcp/tree {
		root * /srv/backend/public
		php_fastcgi backend:9000
	}

	handle /api/* {
		root * /srv/backend/public
		php_fastcgi backend:9000
	}

	handle {
		reverse_proxy frontend:5173
	}
}

# Scoped MCP calls from Docker and the local ACP agent use their own FPM workers.
http://:8082 {
	handle /mcp/agent {
		root * /srv/backend/public
		php_fastcgi backend:9001
	}
	handle {
		respond 404
	}
}
