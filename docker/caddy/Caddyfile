http://:8080 {
	redir https://my-geno-tree.localhost{uri} 302
}

http://127.0.0.1:8081 {
	root * /srv/backend/public
	php_fastcgi backend:9000
}

http://:8082 {
	@voice_authorization path_regexp ^/api/v1/chat-transcription-sessions/[^/]+/authorize$
	handle @voice_authorization {
		root * /srv/backend/public
		php_fastcgi backend:9000
	}
	respond 404
}

localhost, my-geno-tree.localhost {
	tls internal
	encode zstd gzip

	@voice_authorization path_regexp ^/api/v1/chat-transcription-sessions/[^/]+/authorize$
	handle @voice_authorization {
		respond 404
	}

	handle /api/v1/chat-transcriptions/stream {
		reverse_proxy voice-gateway:8080
	}

	handle /.well-known/mercure {
		@subscriber method GET
		forward_auth @subscriber 127.0.0.1:8081 {
			uri /api/v1/chat-events/authorize
			header_up Authorization "Bearer {cookie.__Secure-mercure_access_token}"
		}
		reverse_proxy mercure:80 {
			flush_interval -1
		}
	}

	@backend path /api/* /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @backend {
		root * /srv/backend/public
		php_fastcgi backend:9000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
